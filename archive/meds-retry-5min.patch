+function getTargetSlots(currentHHMM: string) {
+  const [h, m] = currentHHMM.split(':').map(Number)
+  const currentTotalMinutes = h * 60 + m
+  const slots: { time: string; elapsed: number }[] = []
+
+  // Desde 0 hasta 120 minutos atrás (2 horas), cada 5 minutos
+  for (let elapsed = 0; elapsed <= 120; elapsed += 5) {
+    const targetMinutes = currentTotalMinutes - elapsed
+    if (targetMinutes < 0) continue
+    const th = Math.floor(targetMinutes / 60)
+    const tm = targetMinutes % 60
+    const timeStr = `${String(th).padStart(2, '0')}:${String(tm).padStart(2, '0')}`
+    slots.push({ time: timeStr, elapsed })
+  }
+  return slots
+}
